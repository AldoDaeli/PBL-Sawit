# Salin ke .env lalu sesuaikan
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sawitku
DB_PASSWORD=ganti-password-ini
DB_NAME=sawitku

# Frontend dilayani Flask (folder frontend/) dari origin yang sama dengan API, jadi CORS tidak diperlukan.
# Isi CORS_ORIGINS hanya bila frontend dihosting di domain lain (pisahkan dengan koma). Jangan pakai * di produksi.
CORS_ORIGINS=
# Kosongkan agar URL gambar relatif (/media/...). Isi (https://...) hanya bila gambar dilayani dari domain lain.
PUBLIC_BASE_URL=
UPLOAD_DIR=uploads

# --- Sesi & JWT ---
# Rahasia penanda tangan JWT (minimal 32 karakter acak). Kosong = dibuat otomatis lalu disimpan di berkas .jwt_secret.
# Ganti rahasia = semua pengguna otomatis keluar. Buat: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Masa berlaku token; diperpanjang otomatis selama pengguna aktif. Token dipakai bersama semua tab browser.
SESI_MENIT=20
MAKS_GAGAL=5
BLOKIR_MENIT=5
BATAS_BAYAR_JAM=24
# Pesanan yang sudah ditandai tiba oleh admin selesai otomatis bila pembeli tidak konfirmasi dalam sekian jam.
AUTO_TERIMA_JAM=24
MAKS_MB=2

# Jumlah proxy tepercaya di depan aplikasi (1 bila di belakang Nginx). WAJIB diisi di produksi agar pembatas laju per IP
# memakai IP klien asli, bukan IP proxy. Biarkan 0 bila tanpa proxy (jangan isi bila klien bisa menjangkau app langsung).
PROXY_HOPS=0
LAJU_DAFTAR=10
LAJU_KONTAK=5
MAKS_PESANAN_TERTUNDA=5

# --- OTP pendaftaran (kode 6 angka dikirim ke email) ---
# Isi SMTP_HOST agar email sungguhan terkirim. Dibiarkan kosong = mode pengembangan: kode HANYA dicetak di terminal server (Flask).
# Contoh Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_MODE=starttls, SMTP_USER=alamat@gmail.com, SMTP_PASSWORD=<App Password 16 karakter>
SMTP_HOST=
# HANYA untuk pengembangan lokal tanpa SMTP: 1 = kode OTP dicetak di terminal server (Flask) (email tidak dikirim). Di produksi biarkan 0:
# tanpa SMTP_HOST, pendaftaran/ganti email ditolak dengan pesan "Layanan email belum dikonfigurasi".
OTP_CETAK_KODE=0
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OTP_MENIT=10
OTP_MAKS_SALAH=5
OTP_JEDA_DETIK=60
OTP_MAKS_KIRIM=5
LAJU_OTP=30

# --- Midtrans Core API (QRIS + Virtual Account BCA/BNI/BRI/Permata + Mandiri Bill) ---
# Ambil Server Key di dashboard Midtrans > Settings > Access Keys. Sandbox: awalan SB-Mid-server-...
# Kosongkan = pembayaran nonaktif. MIDTRANS_PRODUKSI=1 hanya dengan kunci produksi.
# Di dashboard Midtrans isi "Payment Notification URL" = https://DOMAINMU/api/midtrans/notifikasi
# Pesanan TIDAK pernah disetujui otomatis oleh Midtrans: pembeli wajib unggah bukti, admin yang memverifikasi.
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUKSI=0
